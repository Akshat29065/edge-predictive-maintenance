# Copy to .env to change anything. Every value has the same default in docker-compose.yml,
# so `docker compose up` also works with no .env at all.
TZ=Asia/Kolkata

# InfluxDB (dev credentials; change for any real deployment)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=edge-lab
INFLUXDB_BUCKET=machine
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-please
INFLUXDB_TOKEN=dev-token-change-me

# Modbus: point MODBUS_HOST/PORT at a real device to leave the simulator behind
MODBUS_HOST=simulator
MODBUS_PORT=5020
REPLAY_INTERVAL_S=1
POLL_INTERVAL=1s

# Analytics and vision
ANALYTICS_INTERVAL_S=2
SMOOTH_WINDOWS=10
VISION_INTERVAL_S=5
CAMERA_STATE_MAX_AGE_S=15   # simulated camera shows nothing if the simulator's state file is older than this

# Agent and local LLM (Ollama). LLM_MODE: json (schema-constrained, reliable) or tools (native tool calling)
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_FALLBACK_MODEL=qwen3:0.6b
LLM_MODE=json
LLM_TIMEOUT_S=30
AGENT_INTERVAL_S=10
REMINDER_S=120
STARTUP_GRACE_S=120
LOW_CONF_HOLD_S=60          # a fault reading below 0.8 confidence is acted on once it persists this long
