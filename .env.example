# Copy to .env (cp .env.example .env). The real .env is git-ignored.

# --- Timezone ---
TZ=Asia/Kolkata

# --- InfluxDB ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=edge-lab
INFLUXDB_BUCKET=machine
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-please
INFLUXDB_TOKEN=dev-token-change-me

# --- Modbus simulator and Telegraf ---
MODBUS_HOST=simulator
MODBUS_PORT=5020
REPLAY_INTERVAL_S=1
POLL_INTERVAL=1s
SCENARIO_FILE=/app/scenario.yaml

# --- LLM (Ollama) ---
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_FALLBACK_MODEL=qwen3:0.6b
LLM_TIMEOUT_S=30

# --- Agent ---
AGENT_INTERVAL_S=10
ALERT_LOG=/logs/alerts.log

ANALYTICS_INTERVAL_S=2
SMOOTH_WINDOWS=10

VISION_INTERVAL_S=5